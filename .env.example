# ---- Required ----
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
NEWS_CHANNEL_ID=channel-id-for-auto-posts

# ---- Recommended ----
# If set, commands register instantly in this server (otherwise global, up to 1h delay)
GUILD_ID=your-server-id
# Optional: Anthropic key for high-quality Modern Standard Arabic rewriting.
# Without it the bot falls back to basic machine translation.
ANTHROPIC_API_KEY=

# ---- Optional tuning ----
CRON_SCHEDULE=*/30 * * * *
MAX_POSTS_PER_RUN=3
DATA_DIR=./data
LOGO_URL=
PORT=3000
# Set true for ONE startup to upload logo/name/bio to Discord, then set back to false (rate-limited)
SYNC_PROFILE=false
